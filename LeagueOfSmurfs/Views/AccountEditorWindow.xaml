<Window x:Class="LeagueOfSmurfs.Views.AccountEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Account"
        Width="460"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">
    <Border x:Name="RootBorder"
            CornerRadius="20"
            Background="{DynamicResource Brush.Window}"
            ClipToBounds="True"
            SizeChanged="RootBorder_SizeChanged">
        <Border.RenderTransform>
            <TranslateTransform x:Name="RootTranslate" Y="10"/>
        </Border.RenderTransform>
        <Grid Margin="18,16,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock Style="{StaticResource SectionTitle}" FontSize="14" Text="Account" VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Width="28" Height="28" Click="Close_Click">
                    <Image Source="{Binding Owner.DataContext.CloseImage, RelativeSource={RelativeSource AncestorType=Window}}" Width="12" Height="12"/>
                </Button>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="GameNameBox"
                         Style="{StaticResource GhostField}"
                         Text="{Binding GameName, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Riot game name (3–16)"
                         MaxLength="16"
                         PreviewTextInput="GameNameBox_PreviewTextInput"
                         PreviewKeyDown="GameNameBox_PreviewKeyDown"
                         DataObject.Pasting="GameNameBox_Pasting"/>
                <TextBlock Grid.Column="1" Text="#" Foreground="{DynamicResource Brush.SecondaryText}"
                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                           Margin="6,0,6,0"/>
                <TextBox x:Name="TagBox"
                         Grid.Column="2"
                         Style="{StaticResource GhostField}"
                         Text="{Binding Tag, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Tagline (3–5)"
                         MaxLength="5"
                         PreviewTextInput="TagBox_PreviewTextInput"
                         DataObject.Pasting="TagBox_Pasting"/>
                <ComboBox Grid.Column="4"
                          Style="{StaticResource GhostComboBox}"
                          ItemsSource="{Binding Regions}"
                          SelectedItem="{Binding SelectedRegion}"/>
                <Button Grid.Column="6" Style="{StaticResource PrimaryButton}" Content="Check" Command="{Binding CheckCommand}"
                        VerticalAlignment="Center"/>
            </Grid>

            <Border Grid.Row="4" Background="{DynamicResource Brush.Panel}" CornerRadius="{DynamicResource RadiusMedium}" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding IdentityTitle}"/>
                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding PreviewName}" Margin="0,6,0,0"/>
                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding LevelText}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding LeftTitle}"/>
                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding LeftRank}" Margin="0,6,0,0"/>
                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding LeftScore}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding RightTitle}"/>
                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding RightRank}" Margin="0,6,0,0"/>
                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding RightScore}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="6">
                <TextBlock Style="{StaticResource MutedText}" Text="Username" Margin="0,0,0,4"/>
                <TextBox Style="{StaticResource GhostField}" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Style="{StaticResource MutedText}" Text="Password" Margin="0,10,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="PasswordBox"
                                 Style="{StaticResource GhostPassword}"
                                 PasswordChar="*"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>
                    <TextBox x:Name="PasswordPlainBox"
                             Style="{StaticResource GhostField}"
                             Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="Collapsed"/>
                    <Button Grid.Column="1"
                            Style="{StaticResource IconButton}"
                            Command="{Binding TogglePasswordCommand}"
                            Width="32" Height="32" Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets" FontSize="12"
                            Foreground="{DynamicResource Brush.Accent}"
                            Content="&#xE7B3;"
                            ToolTip="Show / hide password"/>
                </Grid>
                <TextBlock Text="{Binding ErrorText}" Foreground="#FF5555" FontSize="11" Margin="0,6,0,0"
                           Visibility="{Binding ErrorVisible, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <Button Grid.Row="8" Style="{StaticResource PrimaryButton}" Content="Save" Command="{Binding SaveCommand}"
                    HorizontalAlignment="Center" MinWidth="100" Padding="14,8" Click="Save_Click"/>
        </Grid>
    </Border>
</Window>
