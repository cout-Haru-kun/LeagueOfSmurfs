<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Valorant: deep navy surfaces + soft cobalt accent -->
    <SolidColorBrush x:Key="Brush.Window" Color="#0A101C"/>
    <SolidColorBrush x:Key="Brush.TitleBar" Color="#111827"/>
    <SolidColorBrush x:Key="Brush.Panel" Color="#131B2C"/>
    <SolidColorBrush x:Key="Brush.PanelAlt" Color="#00101A2C"/>
    <SolidColorBrush x:Key="Brush.Card" Color="#CC161F33"/>
    <SolidColorBrush x:Key="Brush.Input" Color="#1B2538"/>
    <SolidColorBrush x:Key="Brush.Hover" Color="#243148"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="#5BA4FF"/>
    <SolidColorBrush x:Key="Brush.AccentDark" Color="#3B7DD8"/>
    <SolidColorBrush x:Key="Brush.SecondaryText" Color="#9BB4D4"/>
    <SolidColorBrush x:Key="Brush.Overlay" Color="#B3060A12"/>
    <Color x:Key="Color.Accent">#5BA4FF</Color>
    <Color x:Key="Color.Window">#0A101C</Color>
</ResourceDictionary>
